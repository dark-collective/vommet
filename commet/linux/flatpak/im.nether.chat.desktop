[Desktop Entry]
Version={{VERSION_TAG}}
Type=Application
Name=Vomit (codename)
Comment=Matrix client fork for people who keep ending up back on Discord
Categories=Utility;Amusement;
Icon=im.nether.chat
Exec=commet %u
Terminal=false
StartupWMClass=im.nether.chat
Actions=ToggleMute;Mute;Unmute
X-KDE-StartupNotify=false
StartupNotify=false
MimeType=x-scheme-handler/commetchat;

[Desktop Action ToggleMute]
Name=Toggle Mute
Exec=commet --shortcut toggle_mute
X-KDE-Shortcuts=Alt+M

[Desktop Action Mute]
Name=Mute
Exec=commet --shortcut mute


[Desktop Action Unmute]
Name=Unmute
Exec=commet --shortcut unmute