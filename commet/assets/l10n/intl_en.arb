  "experimentCallCardsTitle": "Call cards and per-call mute",
  "@experimentCallCardsTitle": {
    "description": "Name of the \"Call cards and per-call mute\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentCallCardsDescription": "Each call you're in is a card showing its room, its space, and, with several accounts, which account you're in it with. Mute and deafen are per call: the open card has its own microphone and headphones buttons, a folded card shows a red mark when you're muted or deafened there, and a new call starts the way you left the last one. The buttons by your name act on the open call. No restart needed.",
  "@experimentCallCardsDescription": {
    "description": "Explanation under the \"Call cards and per-call mute\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentSpaceNicknamesTitle": "Nickname per space and room",
  "@experimentSpaceNicknamesTitle": {
    "description": "Name of the \"Nickname per space and room\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentSpaceNicknamesDescription": "Adds \"Your nickname\" to space and room settings: others see that name in the space and every room in it, or just in one room. Vommet writes it as your name in each room (slowly, for big spaces), gives new rooms in the space the same name, and puts it back after you change your global name here. Turning this off stops all of that; names already set stay.",
  "@experimentSpaceNicknamesDescription": {
    "description": "Explanation under the \"Nickname per space and room\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentLastRoomPerSpaceTitle": "Reopen the last room in a space",
  "@experimentLastRoomPerSpaceTitle": {
    "description": "Name of the \"Reopen the last room in a space\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentLastRoomPerSpaceDescription": "Clicking a space takes you back to the room you were in when you left it, like Discord. Click the space again for its main page. Remembered on this device for each account. No restart needed.",
  "@experimentLastRoomPerSpaceDescription": {
    "description": "Explanation under the \"Reopen the last room in a space\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentSelectMessagesTitle": "Select several messages",
  "@experimentSelectMessagesTitle": {
    "description": "Name of the \"Select several messages\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentSelectMessagesDescription": "Adds Select to the message menu, like Telegram: tick several messages, then delete, copy, or forward them in one go. Tap or click a message to tick it, drag along the circles to tick many, or Shift+click to tick a range. Esc, back, or Cancel stops selecting. No restart needed.",
  "@experimentSelectMessagesDescription": {
    "description": "Explanation under the \"Select several messages\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentStreamWatchingTitle": "Watch streams like Discord",
  "@experimentStreamWatchingTitle": {
    "description": "Name of the \"Watch streams like Discord\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentStreamWatchingDescription": "Other people's screen shares wait for you to press Watch stream, so you only download the ones you look at. Each shows a small live preview when the sharer's app sends one, otherwise their picture. While you watch, the controls fade after a few seconds: click the stream to bring them back. They let you mute or turn down the stream's sound, stop watching, or go fullscreen (also a double-click), which now fills your whole screen with your call buttons at the bottom. Takes effect from your next call.",
  "@experimentStreamWatchingDescription": {
    "description": "Explanation under the \"Watch streams like Discord\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
