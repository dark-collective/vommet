  "experimentSidebarSubspaceGuidesTitle": "Clearer subspaces and voice rooms",
  "@experimentSidebarSubspaceGuidesTitle": {
    "description": "Name of the \"Clearer subspaces and voice rooms\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentSidebarSubspaceGuidesDescription": "Subspace names in a space's room list are small capitals with a faint line down the side, so you can see where each subspace ends. Voice rooms get a headphones mark beside their picture that turns green while people are in the call, a green pill at the end of the row with the number of people in it, and a faint green highlight on the row while you're in the call. In a call you're in, people light up while they talk and show when their mic is off. Spaces on the left show green headphones while a call is on in them, or a red screen-share mark while someone shares their screen in your call there. On phones, less of the next panel shows at the edge, leaving more room for room names. No restart needed.",
  "@experimentSidebarSubspaceGuidesDescription": {
    "description": "Explanation under the \"Clearer subspaces and voice rooms\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentManageSpaceRoomsTitle": "Manage a space's rooms",
