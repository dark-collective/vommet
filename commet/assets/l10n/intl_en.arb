    "description": "Name of the \"Keep drafts\" experiment, shown as a toggle title on the Experiments settings page and in settings search",
    "type": "text",
    "placeholders": {}
  },
  "experimentMessageDraftsDescription": "Text you haven't sent stays in the message box when you switch to another room or DM and back, with the message you were replying to. Kept until the app closes, never saved to disk. Takes effect when you next open a room.",
  "@experimentMessageDraftsDescription": {
    "description": "Explanation under the \"Keep drafts\" experiment toggle on the Experiments settings page (also shown in settings search)",
    "type": "text",
    "placeholders": {}
  },
  "experimentBannerLayoutTitle": "Discord-style layout",
