Vommet: build ssplit-cpp's internal PCRE2 with MSVC (Windows). Applied after
00-bergamot-translator.patch by cmake/sources.cmake.

--- a/third_party/bergamot-translator/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake
+++ b/third_party/bergamot-translator/3rd_party/ssplit-cpp/cmake/FindPCRE2.cmake
@@ -80,8 +80,21 @@
     )
   endif(IOS)
 
+  # Vommet: MSVC names the static library pcre2-8-static, and its users must
+  # see PCRE2_STATIC (else pcre2.h declares dllimport). Use the static runtime
+  # (/MT) like the rest of the build, and build the Release configuration
+  # (multi-config generators default to Debug).
+  set(PCRE2_LIB_NAME pcre2-8)
+  set(PCRE2_BUILD_CONFIG "")
+  if(MSVC)
+    LIST(APPEND PCRE2_CONFIGURE_OPTIONS -DPCRE2_STATIC_RUNTIME=ON)
+    set(PCRE2_LIB_NAME pcre2-8-static)
+    set(PCRE2_BUILD_CONFIG --config Release)
+    add_definitions(-DPCRE2_STATIC)
+  endif(MSVC)
+
   # set include dirs and libraries for PCRE2
-  set(PCRE2_LIBRARIES ${CMAKE_BINARY_DIR}/${CMAKE_INSTALL_LIBDIR}/${CMAKE_STATIC_LIBRARY_PREFIX}pcre2-8${CMAKE_STATIC_LIBRARY_SUFFIX})
+  set(PCRE2_LIBRARIES ${CMAKE_BINARY_DIR}/${CMAKE_INSTALL_LIBDIR}/${CMAKE_STATIC_LIBRARY_PREFIX}${PCRE2_LIB_NAME}${CMAKE_STATIC_LIBRARY_SUFFIX})
   set(PCRE2_INCLUDE_DIRS "${CMAKE_BINARY_DIR}/include")
   set(PCRE2_FOUND TRUE CACHE BOOL "Found PCRE2 libraries" FORCE)
   
@@ -92,7 +105,8 @@
     DOWNLOAD_DIR ${PCRE2_SRC_DIR}
     SOURCE_DIR ${PCRE2_SRC_DIR}
     CONFIGURE_COMMAND ${CMAKE_COMMAND} ${PCRE2_SRC_DIR} ${PCRE2_CONFIGURE_OPTIONS}
-    BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR>
+    BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> ${PCRE2_BUILD_CONFIG}
+    INSTALL_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> ${PCRE2_BUILD_CONFIG} --target install
     INSTALL_DIR ${CMAKE_BINARY_DIR}
     BUILD_BYPRODUCTS ${PCRE2_LIBRARIES})
 
